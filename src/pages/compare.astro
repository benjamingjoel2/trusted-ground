---
import Base from '../layouts/Base.astro';
import PageMeta from '../components/PageMeta.astro';
import Sources from '../components/Sources.astro';
import { site } from '../config/site.config';
import { publishedPage, iso } from '../lib/content';
import { url } from '../lib/urls';
import { article } from '../lib/schema';
import { render } from 'astro:content';
import { t } from '../i18n/en';
const entry = await publishedPage('compare');
if (!entry) throw new Error('compare.md must be reviewed and sourced');
const { Content } = await render(entry);
const path = url.compare();
const title = 'Payment protection and trade bodies compared';
const description = 'Sourced comparison tables: how package travel payments are protected in the EU, UK, US and Brazil, and what the main trade bodies are.';
---
<Base title={title} description={description} path={path} crumbs={[{ name: t.nav.compare, path }]}
  schema={[article({ path, title, description, published: iso(entry.data.published), modified: iso(entry.data.reviewed), sources: entry.data.sources })]}>
  <p class="label">Reference</p>
  <h1>{title}</h1>
  <p class="standfirst">{description}</p>
  <PageMeta published={entry.data.published} reviewed={entry.data.reviewed} />
  <div class="prose"><Content /></div>
  <Sources sources={entry.data.sources} />
</Base>
