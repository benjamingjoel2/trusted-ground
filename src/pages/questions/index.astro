---
import StoryListing from '../../components/StoryListing.astro';
import { allStories } from '../../lib/stories';
import { url } from '../../lib/urls';
import { faqPage } from '../../lib/schema';
import { published } from '../../lib/content';
const all = await allStories();
const list = all.filter((s) => s.kind === 'question');
---
<StoryListing path={url.questions()} title="Questions travellers ask" filters={false} crumbs={[{ name: 'Questions', path: url.questions() }]}
  dek="Short, sourced answers to the questions travellers ask about booking with a local operator."
  stories={list} all={all} />
