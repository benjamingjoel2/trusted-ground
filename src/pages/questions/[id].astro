---
import StoryPage from '../../components/StoryPage.astro';
import { url } from '../../lib/urls';
import { published, readMinutes } from '../../lib/content';
import { allStories } from '../../lib/stories';
import { faqPage } from '../../lib/schema';
import { render, type CollectionEntry } from 'astro:content';
export async function getStaticPaths() {
  return (await published('questions')).map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}
const { entry } = Astro.props as { entry: CollectionEntry<'questions'> };
const { Content } = await render(entry);
const d = entry.data;
const path = url.question(entry.id);
const stories = (await allStories()).filter((s) => !(s.kind === 'question' && s.id === entry.id));
const more = [...stories.filter((s) => s.kind === 'question'), ...stories.filter((s) => s.kind !== 'question')].slice(0, 8);
---
<StoryPage path={path} title={d.title} description={d.description} category="Questions" lead={d.short_answer}
  published={d.published} reviewed={d.reviewed} minutes={readMinutes(entry.body)} hero={d.hero} sources={d.sources} more={more}
  schema={[faqPage(path, [{ q: d.title, a: d.short_answer }])]}>
  <Content />
</StoryPage>
