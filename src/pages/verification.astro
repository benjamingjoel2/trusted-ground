---
import Base from '../layouts/Base.astro';
import PageMeta from '../components/PageMeta.astro';
import Sources from '../components/Sources.astro';
import Check from '../components/Check.astro';
import { site, tiers, tierSources, disclosure, type TierKey } from '../config/site.config';
import { getFeed } from '../lib/feed';
import { url } from '../lib/urls';
import { article } from '../lib/schema';
import { t } from '../i18n/en';
const feed = getFeed();
const path = url.verification();
const title = 'How verification works';
const description = 'Exactly what Tourground checks for each tier (Verified, Black, Platinum and Founder), what each check does not mean, and how often records are checked.';
const order: TierKey[] = ['verified', 'black', 'platinum', 'founder'];
const counts = Object.fromEntries(order.map((k) => [k, feed.companies.filter((c) => c.tier === k).length]));
---
<Base title={title} description={description} path={path} crumbs={[{ name: t.nav.verification, path }]}
  schema={[article({ path, title, description, published: site.launch.published, modified: site.launch.published, sources: tierSources })]}>
  <p class="label">Method</p>
  <h1>{title}</h1>
  <p class="standfirst">A company appears on {site.name} only if the Tourground directory feed marks it verified, or marks it as founder-owned. Everything else, including companies Tourground lists from public information only, is left out.</p>
  <PageMeta published={site.launch.published} reviewed={site.launch.published} />

  <h2 id="rule">The rule for being listed</h2>
  <p><span class="vstate"><Check />Verified</span> or founder-owned in the feed: listed. Not verified and not founder-owned: not listed, whatever any other dataset says. If a company is removed from the feed or loses its status, its page is removed in the next build of this site.</p>

  {order.map((k) => {
    const tier = tiers[k];
    return (
      <section aria-labelledby={`tier-${k}`}>
        <h2 id={`tier-${k}`}>{tier.label}{tier.paid ? ' (paid plan)' : ''}</h2>
        <p>{tier.short}</p>
        <h3>What is checked</h3>
        <ul>{tier.checks.map((x) => <li>{x}</li>)}</ul>
        <h3>What it does not mean</h3>
        <ul>{tier.notChecked.map((x) => <li>{x}</li>)}</ul>
        <p class="small muted">Companies at this tier in the current feed: {counts[k]}.</p>
      </section>
    );
  })}

  <h2 id="limits">What verification is not</h2>
  <p>Verification is a check by a directory publisher. It is not a government licence, an insurance policy, a bond or a guarantee that a trip will go as planned. Check those separately, using the <a href={url.guide()}>booking guide</a> and the <a href={url.checklist()}>before-you-pay checklist</a>.</p>
  <p>{disclosure.founderNote}</p>
  <p>{disclosure.platinumNote}</p>
  <p>Each company page shows who checked the record and the date of the last check, taken from the directory feed. To report an error, use <a href={site.links.correctionUrl}>{t.correction}</a>.</p>
  <Sources sources={tierSources} />
</Base>
