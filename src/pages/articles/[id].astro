---
import StoryPage from '../../components/StoryPage.astro';
import { url } from '../../lib/urls';
import { published, readMinutes } from '../../lib/content';
import { allStories } from '../../lib/stories';
import { render, type CollectionEntry } from 'astro:content';
export async function getStaticPaths() {
  return (await published('articles')).map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}
const { entry } = Astro.props as { entry: CollectionEntry<'articles'> };
const { Content } = await render(entry);
const d = entry.data;
const stories = (await allStories()).filter((s) => !(s.kind === 'article' && s.id === entry.id));
const related = stories.filter((s) => s.category === d.category || s.countries.some((c) => d.countries.includes(c)));
const more = [...related, ...stories.filter((s) => !related.includes(s))].slice(0, 8);
---
<StoryPage path={url.article(entry.id)} title={d.title} description={d.description} category={d.category}
  published={d.published} reviewed={d.reviewed} minutes={readMinutes(entry.body)} hero={d.hero ?? d.countries[0]} sources={d.sources} more={more}>
  <Content />
</StoryPage>
