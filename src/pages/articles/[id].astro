---
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';
import Sources from '../../components/Sources.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Carousel from '../../components/Carousel.astro';
import { url } from '../../lib/urls';
import { published, iso, fmtDate, readMinutes } from '../../lib/content';
import { article } from '../../lib/schema';
import { destName } from '../../lib/feed';
import { placePhoto, creditLine } from '../../lib/images';
import { site } from '../../config/site.config';
import { render, type CollectionEntry } from 'astro:content';
import { t } from '../../i18n/en';
export async function getStaticPaths() {
  const list = await published('articles');
  return list.map((entry) => ({ params: { id: entry.id }, props: { entry, others: list.filter((x) => x.id !== entry.id) } }));
}
type E = CollectionEntry<'articles'>;
const { entry, others } = Astro.props as { entry: E; others: E[] };
const { Content } = await render(entry);
const d = entry.data;
const path = url.article(entry.id);
const heroSlug = d.hero ?? d.countries[0];
const photo = heroSlug ? placePhoto(heroSlug) : null;
const related = others.filter((o) => o.data.category === d.category || o.data.countries.some((c) => d.countries.includes(c)));
const more = [...related, ...others.filter((o) => !related.includes(o))].slice(0, 8);
---
<Base title={d.title} description={d.description} path={path} full ogType="article"
  crumbs={[{ name: t.nav.articles, path: url.articles() }, { name: d.title, path }]}
  schema={[article({ path, title: d.title, description: d.description, published: iso(d.published), modified: iso(d.reviewed), sources: d.sources })]}>
  <header class="ahead">
    <div class="ahead-text">
      <a class="chip" href={url.articles()}>{d.category}</a>
      <div class="ahead-bottom">
        <h1>{d.title}</h1>
        <p class="ahead-meta">{fmtDate(d.published)} <span aria-hidden="true">•</span> <span class="mono">{readMinutes(entry.body)} min read</span></p>
        <div class="byline"><span class="byline-name">{site.name} editors</span><span class="mono">Writer</span></div>
        {photo && <p class="ahead-credit">{destName(heroSlug!)}. <a href={photo.credit.page}>{creditLine(photo.credit)}</a></p>}
      </div>
    </div>
    <div class="ahead-photo">{heroSlug && <Photo slug={heroSlug} alt={destName(heroSlug)} priority credit={false} sizes="(min-width: 64rem) 50vw, 100vw" widths={[480, 720, 960, 1280]} />}</div>
  </header>
  <div class="wrap">
    <article class="abody">
      <p class="adisclaimer">{site.name} articles are written from official sources, listed at the end. Rules, fees and advice change: check them before you book. Last reviewed {fmtDate(d.reviewed)}.</p>
      <div class="prose"><Content /></div>
      <Sources sources={d.sources} />
    </article>
  </div>
  {more.length > 0 && (
    <section class="section section-grey" aria-labelledby="more-h">
      <div class="wrap">
        <div class="sec-head"><h2 id="more-h">More stories</h2><div class="sec-tools"><a class="viewall" href={url.articles()}>Read more</a><Carousel id="row-more" label="more stories" /></div></div>
        <div class="row" id="row-more">{more.map((a) => <ArticleCard a={a} />)}</div>
      </div>
    </section>
  )}
</Base>
