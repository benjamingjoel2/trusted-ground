---
import StoryListing from '../../components/StoryListing.astro';
import { allStories } from '../../lib/stories';
import { url } from '../../lib/urls';
import { t } from '../../i18n/en';
const all = await allStories();
---
<StoryListing path={url.articles()} title="Travel advice and inspiration" crumbs={[{ name: t.nav.guide, path: url.articles() }]}
  dek="Plan your next trip with practical, sourced travel advice: permits and park rules, seasons, travel guides and answers to the questions travellers ask."
  stories={all} all={all} />
