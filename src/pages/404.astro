---
import Base from '../layouts/Base.astro';
import { url } from '../lib/urls';
import { t } from '../i18n/en';
---
<Base title={t.notFound} description="This page does not exist or has moved." path="/404/" noindex>
  <h1>{t.notFound}</h1>
  <p>This page does not exist or has moved.</p>
  <ul>
    <li><a href={url.countries()}>Country index</a></li>
    <li><a href={url.articles()}>Travel articles</a></li>
  </ul>
</Base>
