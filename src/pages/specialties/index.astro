---
import Base from '../../layouts/Base.astro';
import PageMeta from '../../components/PageMeta.astro';
import MockNotice from '../../components/MockNotice.astro';
import { getFeed } from '../../lib/feed';
import { site, niches, disclosure } from '../../config/site.config';
import { url } from '../../lib/urls';
import { article } from '../../lib/schema';
import { t } from '../../i18n/en';
const feed = getFeed();
const path = url.specialties();
const title = 'Local operators by specialty';
const description = 'Verified local operators by specialty: safari, trekking and mountains, culture and heritage, wildlife and diving, family, honeymoon, overland, and heritage journeys.';
---
<Base title={title} description={description} path={path} crumbs={[{ name: t.nav.best, path }]}
  schema={[article({ path, title, description, published: site.launch.published, modified: feed.latestCheck })]}>
  <p class="label">Specialties</p>
  <h1>{title}</h1>
  <p class="standfirst">{disclosure.listingStatement}</p>
  <PageMeta published={site.launch.published} reviewed={feed.latestCheck} reviewedLabel="Directory last checked" />
  <MockNotice />
  <ul class="entries">
    {niches.map((n) => {
      const m = feed.niche.get(n.slug)!;
      const count = [...m.values()].reduce((s, l) => s + l.length, 0);
      return (
        <li><div>
          {count > 0 ? <a href={url.niche(n.slug)}>{n.name}</a> : <span>{n.name}</span>}
          <p>{count > 0 ? `${t.operatorsListed(count)} in ${t.countriesListed(m.size)}` : 'No listed operator has this specialty yet.'}</p>
        </div></li>
      );
    })}
  </ul>
</Base>
