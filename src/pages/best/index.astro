---
import Base from '../../layouts/Base.astro';
import PageMeta from '../../components/PageMeta.astro';
import MockNotice from '../../components/MockNotice.astro';
import AdSlot from '../../components/AdSlot.astro';
import { getFeed } from '../../lib/feed';
import { site, niches, regions, disclosure } from '../../config/site.config';
import { url } from '../../lib/urls';
import { article } from '../../lib/schema';
import { t } from '../../i18n/en';
const feed = getFeed();
const path = url.best();
const title = 'Ranked lists: best local operators';
const description = 'Ranked lists of verified local operators: the best in each country, and by niche across countries. Rank comes only from the Tourground directory.';
---
<Base title={title} description={description} path={path} crumbs={[{ name: t.nav.best, path }]}
  schema={[article({ path, title, description, published: site.launch.published, modified: feed.latestCheck })]}>
  <AdSlot />
  <h1>Ranked lists</h1>
  <p class="standfirst">{disclosure.rankingStatement}</p>
  <PageMeta published={site.launch.published} reviewed={feed.latestCheck} reviewedLabel="Directory last checked" />
  <MockNotice />
  <h2>By niche, across countries</h2>
  <ol class="entries">
    {niches.map((n) => {
      const m = feed.niche.get(n.slug)!;
      const count = [...m.values()].reduce((s, l) => s + l.length, 0);
      return (
        <li><div>
          {count > 0 ? <a href={url.niche(n.slug)}>Best local operators for {n.name.toLowerCase()}</a> : <span>{n.name}</span>}
          <p>{count > 0 ? `${t.operatorsListed(count)} in ${t.countriesListed(m.size)}` : 'No verified operator lists this niche yet.'}</p>
        </div></li>
      );
    })}
  </ol>
  <h2>Best local operators in each country</h2>
  {regions.map((r) => {
    const l = feed.countriesByRegion.get(r.slug) ?? [];
    return l.length > 0 && (
      <>
        <h3>{r.name}</h3>
        <ul class="cols">{l.map((d) => <li><a href={url.country(d.slug)}>Best in {d.name}</a><span class="count">{feed.rankedByCountry.get(d.slug)!.length}</span></li>)}</ul>
      </>
    );
  })}
</Base>
