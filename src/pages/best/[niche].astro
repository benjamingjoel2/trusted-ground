---
import Base from '../../layouts/Base.astro';
import PageMeta from '../../components/PageMeta.astro';
import MockNotice from '../../components/MockNotice.astro';
import AdSlot from '../../components/AdSlot.astro';
import RankedList from '../../components/RankedList.astro';
import Sources from '../../components/Sources.astro';
import { getFeed } from '../../lib/feed';
import { site, niches, disclosure } from '../../config/site.config';
import { url, abs } from '../../lib/urls';
import { article } from '../../lib/schema';
import { t } from '../../i18n/en';
export function getStaticPaths() {
  const feed = getFeed();
  // A niche list is generated only when at least one listed company has that niche.
  return niches.filter((n) => feed.niche.get(n.slug)!.size > 0).map((n) => ({ params: { niche: n.slug }, props: { n } }));
}
const { n } = Astro.props as { n: (typeof niches)[number] };
const feed = getFeed();
const groups = feed.countries.filter((d) => feed.niche.get(n.slug)!.has(d.slug)).map((d) => ({ d, entries: feed.niche.get(n.slug)!.get(d.slug)! }));
const total = groups.reduce((s, g) => s + g.entries.length, 0);
const path = url.niche(n.slug);
const title = `Best local operators for ${n.name.toLowerCase()}`;
const description = `${t.operatorsListed(total)} listing ${n.name.toLowerCase()} as a specialty, in ${t.countriesListed(groups.length)}. Grouped by country, in each country's directory rank order.`;
const checked = groups.flatMap((g) => g.entries).reduce((m, e) => (e.company.last_checked > m ? e.company.last_checked : m), site.launch.published);
const lists = groups.map((g) => ({
  '@type': 'ItemList',
  name: `${title} in ${g.d.name}`,
  itemListOrder: 'https://schema.org/ItemListOrderAscending',
  numberOfItems: g.entries.length,
  itemListElement: g.entries.map((e, i) => ({ '@type': 'ListItem', position: i + 1, name: e.company.name, url: abs(url.operator(e.company.id)) })),
}));
---
<Base title={title} description={description} path={path}
  crumbs={[{ name: t.nav.best, path: url.best() }, { name: n.name, path }]}
  schema={[article({ path, title, description, published: site.launch.published, modified: checked }), ...lists]}>
  <AdSlot />
  <p class="label">Ranked list · {n.name}</p>
  <h1>{title}</h1>
  <p class="standfirst">{description}</p>
  <PageMeta published={site.launch.published} reviewed={checked} reviewedLabel="Directory last checked" />
  <MockNotice />
  <p class="small">Rank is per country, so this list is grouped by country and never re-ordered across countries. {disclosure.rankingStatement}</p>
  {groups.map((g) => (
    <section aria-labelledby={`c-${g.d.slug}`}>
      <h2 id={`c-${g.d.slug}`}><a href={url.country(g.d.slug)}>{g.d.name}</a></h2>
      <RankedList entries={g.entries} caption={`${title} in ${g.d.name}`} />
    </section>
  ))}
  <Sources sources={[{ url: site.publisher.url + '/', label: 'Tourground directory feed (niches and ranks)' }]} />
</Base>
