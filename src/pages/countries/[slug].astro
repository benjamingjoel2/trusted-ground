---
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';
import CountryCard from '../../components/CountryCard.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Carousel from '../../components/Carousel.astro';
import Icon from '../../components/Icon.astro';
import { getFeed, type Destination } from '../../lib/feed';
import { regions, site } from '../../config/site.config';
import { url } from '../../lib/urls';
import { published, iso, fmtDate } from '../../lib/content';
import { placePhoto, creditLine } from '../../lib/images';
import { article, placeNode } from '../../lib/schema';
import { render } from 'astro:content';
import { t } from '../../i18n/en';

export function getStaticPaths() {
  return getFeed().countries.map((d) => ({ params: { slug: d.slug }, props: { d } }));
}
const { d } = Astro.props as { d: Destination };
const feed = getFeed();
const region = regions.find((r) => r.slug === d.region)!;
const snapId = d.content_dir ? d.content_dir.split('/').pop() : d.slug;
const snap = (await published('countries')).find((e) => e.id === snapId);
const Snap = snap ? (await render(snap)).Content : null;
const all = (await published('articles')).sort((a, b) => b.data.published.getTime() - a.data.published.getTime());
const about = all.filter((a) => a.data.countries.includes(d.slug) || a.data.hero === d.slug);
const latest = [...about, ...all.filter((a) => !about.includes(a))].slice(0, 4);
const path = url.country(d.slug);
const title = `${d.name} travel guide`;
const intro = snap ? `${snap.data.main_regions.length ? `From ${snap.data.main_regions.slice(0, 3).join(', ')} and beyond: ` : ''}when to go, how to get in and what to know before you travel to ${d.name}.` : `When to go, how to get in and what to know before you travel to ${d.name}.`;
const description = intro.slice(0, 200);
const pub = snap ? iso(snap.data.published) : site.launch.published;
const reviewed = snap ? iso(snap.data.reviewed) : site.launch.published;
const photo = placePhoto(d.slug);
const nearby = (feed.countriesByRegion.get(d.region) ?? []).filter((x) => x.slug !== d.slug);
const tips = [
  snap?.data.best_months && { icon: 'calendar', title: 'Best time to visit', text: snap.data.best_months },
  snap && snap.data.main_regions.length > 0 && { icon: 'map', title: 'Where to go', text: snap.data.main_regions.join(', ') },
  snap?.data.entry_basics && { icon: 'passport', title: 'Entry requirements', text: snap.data.entry_basics },
].filter(Boolean) as { icon: 'calendar' | 'map' | 'passport'; title: string; text: string }[];
---
<Base title={title} description={description} path={path} full
  crumbs={[{ name: region.name, path: url.region(region.slug) }, { name: d.name, path }]}
  schema={[placeNode(d, path), article({ path, title, description, published: pub, modified: reviewed, sources: snap?.data.sources ?? [], about: { '@id': new URL(path, site.url) + '#place' } })]}>
  <section class="dest" aria-labelledby="dest-h">
    <div class="dest-main">
      <a class="chip chip-white" href={url.region(region.slug)}>{region.name}</a>
      <h1 id="dest-h" class="display">{d.name}<span class="vh"> travel guide</span></h1>
      <p>{intro} <a href="#tips">Read more</a></p>
      <Photo slug={d.slug} alt={`Landscape in ${d.name}`} priority credit={false} sizes="(min-width: 64rem) 46vw, 100vw" widths={[480, 720, 960, 1280]} />
      {photo && <p class="dest-credit"><a href={photo.credit.page}>{creditLine(photo.credit)}</a></p>}
    </div>
    <div class="dest-side">
      <h2 class="boxlabel">Latest stories</h2>
      <ul class="storylist">
        {latest.map((a) => (
          <li><p class="mono">{site.name} editors <span aria-hidden="true">|</span> {fmtDate(a.data.published)}</p><a href={url.article(a.id)}>{a.data.title}</a></li>
        ))}
      </ul>
      {d.booster_url && (
        <>
          <h2 class="boxlabel">More on {d.name}</h2>
          <a class="promo" href={d.booster_url}><span class="mono">Country guide</span><strong>{new URL(d.booster_url).hostname}</strong><span class="pill pill-dark pill-plain">Visit</span></a>
        </>
      )}
    </div>
  </section>

  <section class="section kn" id="tips" aria-labelledby="tips-h">
    <div class="wrap">
      <div class="sec-head">
        <div><p class="mono kn-kicker">Travel guide</p><h2 id="tips-h">{d.name} travel tips</h2></div>
        <p class="mono kn-date">Last reviewed {fmtDate(reviewed)}</p>
      </div>
      <div class="kn-grid">
        <div class="kn-fact">
          <p class="mono kn-label"><Icon name="calendar" />When to go</p>
          {snap?.data.best_months ? <p class="kn-big">{snap.data.best_months}</p> : <p class="kn-muted">We have not yet reviewed an official source for the best months. Ask your operator which months suit your route, and why.</p>}
        </div>
        <div class="kn-fact">
          <p class="mono kn-label"><Icon name="map" />Where to go</p>
          {snap && snap.data.main_regions.length > 0 ? (
            <ul class="kn-chips">{snap.data.main_regions.map((r) => <li>{r}</li>)}</ul>
          ) : <p class="kn-muted">No reviewed source yet.</p>}
        </div>
        <div class="kn-fact">
          <p class="mono kn-label"><Icon name="passport" />Entry requirements</p>
          <p>{snap?.data.entry_basics ?? 'Check your own government\'s travel advice.'}</p>
        </div>
      </div>
      {snap && Snap && (snap.body ?? '').trim().length > 0 && (
        <div class="kn-advice">
          <p class="mono kn-label"><Icon name="alert" />Things to know</p>
          <div class="prose"><Snap /></div>
        </div>
      )}
      {snap && snap.data.sources.length > 0 && (
        <details class="kn-sources">
          <summary class="mono">Sources ({snap.data.sources.length})</summary>
          <ol>{snap.data.sources.map((x) => <li><a href={x.url} rel="noopener">{x.label}</a></li>)}</ol>
        </details>
      )}
    </div>
  </section>

  <section class="section" aria-labelledby="ls-h">
    <div class="wrap">
      <div class="sec-head"><h2 id="ls-h">{about.length ? `Latest stories from ${d.name}` : 'Latest travel stories'}</h2><div class="sec-tools"><a class="viewall" href={url.articles()}>Read more</a><Carousel id="row-ls" label="stories" /></div></div>
      <div class="row" id="row-ls">{(about.length ? about : all).slice(0, 10).map((a) => <ArticleCard a={a} />)}</div>
    </div>
  </section>

  {nearby.length > 0 && (
    <section class="section section-grey" aria-labelledby="near-h">
      <div class="wrap">
        <div class="sec-head"><h2 id="near-h">{d.name} and beyond</h2><div class="sec-tools"><a class="viewall" href={url.region(region.slug)}>View all</a><Carousel id="row-near" label="destinations" /></div></div>
        <div class="row" id="row-near">{nearby.map((x) => <CountryCard d={x} />)}</div>
      </div>
    </section>
  )}
</Base>
