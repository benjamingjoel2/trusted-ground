---
import Base from '../../layouts/Base.astro';
import CountryCard from '../../components/CountryCard.astro';
import { getFeed } from '../../lib/feed';
import { site } from '../../config/site.config';
import { url, abs } from '../../lib/urls';
import { article } from '../../lib/schema';
import { t } from '../../i18n/en';
const feed = getFeed();
const path = url.countries();
const title = 'Explore top travel destinations';
const description = `Travel guides to ${t.countriesListed(feed.countries.length)}: when to go, where to go, how to get in, and the stories we have published about each.`;
const list = { '@type': 'ItemList', name: 'Destinations', numberOfItems: feed.countries.length, itemListElement: feed.countries.map((d, i) => ({ '@type': 'ListItem', position: i + 1, name: d.name, url: abs(url.country(d.slug)) })) };
---
<Base title={title} description={description} path={path} full crumbs={[{ name: t.nav.countries, path }]}
  schema={[article({ path, title, description, published: site.launch.published, modified: site.launch.published }), list]}>
  <div class="wrap listing">
    <h1>Explore top travel destinations</h1>
    <p class="listing-dek">{description}</p>
    <p class="results">Results ({feed.countries.length})</p>
    <div class="grid4">{feed.countries.map((d) => <CountryCard d={d} />)}</div>
  </div>
</Base>
