---
import Base from '../../layouts/Base.astro';
import PageMeta from '../../components/PageMeta.astro';
import MockNotice from '../../components/MockNotice.astro';
import Sources from '../../components/Sources.astro';
import Photo from '../../components/Photo.astro';
import CountryCard from '../../components/CountryCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getFeed } from '../../lib/feed';
import { regions, site } from '../../config/site.config';
import { url, abs } from '../../lib/urls';
import { placePhoto } from '../../lib/images';
import { article } from '../../lib/schema';
import { t } from '../../i18n/en';
export function getStaticPaths() {
  return regions.map((r) => ({ params: { slug: r.slug }, props: { r } }));
}
const { r } = Astro.props as { r: (typeof regions)[number] };
const feed = getFeed();
const list = feed.countriesByRegion.get(r.slug) ?? [];
const path = url.region(r.slug);
const ops = new Set(list.flatMap((d) => feed.byCountry.get(d.slug)!.map((e) => e.company.id))).size;
const lname = r.name.replace(/^The /, 'the ');
const title = `Local tour operators in ${lname}`;
const description = list.length
  ? `${t.countriesListed(list.length)} in ${lname} with verified or founder-owned local operators (${t.operatorsCount(ops)}), from the Tourground directory.`
  : `No verified local operators are listed in ${lname} yet.`;
const checked = list.flatMap((d) => feed.byCountry.get(d.slug)!).reduce((m, e) => (e.company.last_checked > m ? e.company.last_checked : m), site.launch.published);
const heroSlug = [...list].sort((a, b) => feed.byCountry.get(b.slug)!.length - feed.byCountry.get(a.slug)!.length).map((d) => d.slug).find((s) => placePhoto(s));
const placeList = {
  '@type': 'ItemList',
  name: `Countries in ${r.name} with verified operators`,
  numberOfItems: list.length,
  itemListElement: list.map((d, i) => ({ '@type': 'ListItem', position: i + 1, name: d.name, url: abs(url.country(d.slug)) })),
};
---
<Base title={title} description={description} path={path} full
  crumbs={[{ name: t.nav.regions, path: url.regions() }, { name: r.name, path }]}
  schema={[article({ path, title, description, published: site.launch.published, modified: checked }), placeList]}>
  <section class="hero" aria-labelledby="r-h" style="min-height:min(60vh,34rem)">
    {heroSlug && <Photo slug={heroSlug} alt="" priority sizes="100vw" widths={[640, 960, 1280, 1600]} />}
    <div class="wrap hero-body">
      <p class="hero-kicker">Region</p>
      <h1 id="r-h" class="display"><span class="vh">Local tour operators in </span>{r.name}</h1>
      <div class="callout"><p>{description}</p></div>
    </div>
  </section>
  <div class="wrap">
    <div style="padding-top:1.5rem"><Breadcrumbs items={[{ name: t.breadcrumbHome, path: '/' }, { name: t.nav.regions, path: url.regions() }, { name: r.name, path }]} /></div>
    <PageMeta published={site.launch.published} reviewed={checked} reviewedLabel="Directory last checked" />
    <MockNotice />
    {list.length > 0 ? (
      <div class="grid" style="padding-bottom:3rem">{list.map((d) => <CountryCard d={d} />)}</div>
    ) : (
      <p>This region has no verified operators in the directory yet, so it has no country pages. The <a href={url.guide()}>booking guide</a> and <a href={url.checklist()}>checklist</a> apply anywhere.</p>
    )}
    <Sources sources={[{ url: site.publisher.url + '/', label: 'Tourground directory feed (countries and counts)' }]} />
    <div style="height:3rem"></div>
  </div>
</Base>
