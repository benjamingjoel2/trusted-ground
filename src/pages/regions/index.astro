---
import Base from '../../layouts/Base.astro';
import PageMeta from '../../components/PageMeta.astro';
import { getFeed } from '../../lib/feed';
import { regions, site } from '../../config/site.config';
import { url } from '../../lib/urls';
import { article } from '../../lib/schema';
import { t } from '../../i18n/en';
const feed = getFeed();
const path = url.regions();
const title = 'Regions';
const description = 'Destination guides by world region: Africa, Asia, Europe, the Americas, the Middle East, Oceania and the Poles.';
---
<Base title={title} description={description} path={path} crumbs={[{ name: t.nav.regions, path }]}
  schema={[article({ path, title, description, published: site.launch.published, modified: site.launch.published })]}>
  <h1>Regions</h1>
  <p class="standfirst">{description}</p>
  <PageMeta published={site.launch.published} reviewed={site.launch.published} />
  <ol class="entries">
    {regions.map((r) => {
      const l = feed.countriesByRegion.get(r.slug) ?? [];
      return (<li><div><a href={url.region(r.slug)}>{r.name}</a><p>{l.length ? `${t.countriesListed(l.length)}: ${l.slice(0, 6).map((d) => d.name).join(', ')}${l.length > 6 ? '…' : ''}` : 'No destination guides yet.'}</p></div></li>);
    })}
  </ol>
</Base>
