---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import CountryCard from '../components/CountryCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Tile from '../components/Tile.astro';
import Carousel from '../components/Carousel.astro';
import { getFeed } from '../lib/feed';
import { site } from '../config/site.config';
import { url } from '../lib/urls';
import { published, fmtDate, readMinutes } from '../lib/content';
import { placePhoto } from '../lib/images';
import { getImage } from 'astro:assets';

const feed = getFeed();
const stories = (await published('articles')).sort((a, b) => b.data.published.getTime() - a.data.published.getTime() || a.data.title.localeCompare(b.data.title));
const featured = stories[0];
const rest = stories.slice(1);
const categories = [...new Set(stories.map((a) => a.data.category))];
const questions = (await published('questions')).sort((a, b) => a.data.order - b.data.order);
const withPhoto = (slugs: string[]) => slugs.find((s) => placePhoto(s)) ?? '';
const destinations = feed.countries.filter((d) => placePhoto(d.slug));
const featuredDest = ['peru', 'japan', 'iceland', 'tanzania', 'bhutan', 'chile', 'cambodia', 'botswana', 'georgia', 'nepal', 'namibia', 'portugal']
  .map((s) => destinations.find((d) => d.slug === s)).filter(Boolean) as typeof destinations;
const heroSlug = featured ? (featured.data.hero ?? featured.data.countries[0]) : site.heroPhoto;
const heroPhoto = heroSlug && placePhoto(heroSlug) ? heroSlug : site.heroPhoto;
const heroImg = placePhoto(heroPhoto) ? await getImage({ src: placePhoto(heroPhoto)!.src, widths: [640, 960, 1280, 1600], format: 'webp', quality: 70 }) : null;
---
<Base title={site.name} description={site.positioning} path="/" ogType="website" full preloadSrcset={heroImg?.srcSet.attribute} preloadSizes="100vw">
  <section class="hero hero-b" aria-labelledby="hero-h">
    <Photo slug={heroPhoto} alt="" priority sizes="100vw" widths={[640, 960, 1280, 1600]} />
    <div class="wrap hero-body">
      {featured ? (
        <>
          <p class="hero-chip mono">Featured story</p>
          <h1 id="hero-h" class="hero-title"><a href={url.article(featured.id)}>{featured.data.title}</a></h1>
          <p class="hero-dek">{featured.data.description}</p>
          <a class="pill pill-light" href={url.article(featured.id)}>Read the story</a>
        </>
      ) : (
        <>
          <p class="hero-chip mono">{site.name}</p>
          <h1 id="hero-h" class="hero-title">{site.tagline}</h1>
          <p class="hero-dek">{site.positioning}</p>
          <a class="pill pill-light" href={url.articles()}>Read the stories</a>
        </>
      )}
    </div>
    {rest.length > 0 && (
      <nav class="hero-strip" aria-label="More stories">
        {rest.slice(0, 3).map((a) => (
          <a href={url.article(a.id)}><span class="mono">{a.data.category}</span>{a.data.title}</a>
        ))}
      </nav>
    )}
  </section>

  {rest.length > 3 && (
    <section class="section" aria-labelledby="latest-h">
      <div class="wrap">
        <div class="sec-head">
          <h2 id="latest-h">Latest travel stories</h2>
          <div class="sec-tools"><a class="viewall" href={url.articles()}>View all</a><Carousel id="row-latest" label="latest stories" /></div>
        </div>
        <div class="row" id="row-latest">{rest.slice(3, 15).map((a) => <ArticleCard a={a} />)}</div>
      </div>
    </section>
  )}

  <section class="section section-band" aria-labelledby="start-h">
    <div class="wrap">
      <h2 id="start-h" class="band-rule"><span>Your trip starts here.</span><span class="line" aria-hidden="true"></span><span class="r">Choose your first step.</span></h2>
      <div class="tiles">
        <Tile slug={withPhoto(['georgia', 'nepal'])} kicker="Get inspired" title="Stories" href={url.articles()} cta="All articles" />
        <Tile slug={withPhoto(['chile', 'iceland'])} kicker="Where to go" title="Destinations" href={url.countries()} cta="Browse countries" />
        <Tile slug={withPhoto(['zambia', 'botswana'])} kicker="Before you book" title="Booking guide" href={url.guide()} cta="Read the guide" />
        <Tile slug={withPhoto(['cambodia', 'japan'])} kicker="One page" title="The checklist" href={url.checklist()} cta="Print it" />
      </div>
    </div>
  </section>

  {categories.map((c, i) => {
    const list = stories.filter((a) => a.data.category === c);
    const id = `cat-${i}`;
    return list.length > 0 && (
      <section class={`section${i % 2 ? ' section-grey' : ''}`} aria-labelledby={`${id}-h`}>
        <div class="wrap">
          <div class="sec-head">
            <h2 id={`${id}-h`}>{c}</h2>
            <div class="sec-tools"><a class="viewall" href={url.articles()}>View all</a>{list.length > 4 && <Carousel id={id} label={c} />}</div>
          </div>
          <div class="row" id={id}>{list.map((a) => <ArticleCard a={a} />)}</div>
        </div>
      </section>
    );
  })}

  <section class="section" aria-labelledby="dest-h">
    <div class="wrap">
      <div class="sec-head">
        <div><h2 id="dest-h">Destinations</h2><p>Travel guides to {feed.countries.length} countries: when to go, where to go and how to get in.</p></div>
        <div class="sec-tools"><a class="viewall" href={url.countries()}>View all</a><Carousel id="row-dest" label="destinations" /></div>
      </div>
      <div class="row" id="row-dest">{featuredDest.map((d) => <CountryCard d={d} />)}</div>
    </div>
  </section>

  {questions.length > 0 && (
    <section class="section section-grey" aria-labelledby="q-h">
      <div class="wrap">
        <div class="sec-head">
          <h2 id="q-h">Questions travellers ask</h2>
          <div class="sec-tools"><a class="viewall" href={url.questions()}>View all</a><Carousel id="row-q" label="questions" /></div>
        </div>
        <div class="row" id="row-q">
          {questions.map((q) => (
            <article class="card card-text">
              <p class="meta"><span>Question</span><span>Short answer</span></p>
              <h3><a href={url.question(q.id)}>{q.data.title}</a></h3>
              <p>{q.data.short_answer.split('. ')[0]}.</p>
              <a class="pill" href={url.question(q.id)} aria-label={`Read the answer: ${q.data.title}`}>Read the answer</a>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}
</Base>
