---
import Base from '../layouts/Base.astro';
import MockNotice from '../components/MockNotice.astro';
import Photo from '../components/Photo.astro';
import CountryCard from '../components/CountryCard.astro';
import Tile from '../components/Tile.astro';
import Carousel from '../components/Carousel.astro';
import Check from '../components/Check.astro';
import { getFeed } from '../lib/feed';
import { site, regions, niches, disclosure } from '../config/site.config';
import { url } from '../lib/urls';
import { published } from '../lib/content';
import { placePhoto } from '../lib/images';
import { t } from '../i18n/en';
import { getImage } from 'astro:assets';

const feed = getFeed();
const questions = (await published('questions')).sort((a, b) => a.data.order - b.data.order);
const byCount = [...feed.countries].sort((a, b) => feed.rankedByCountry.get(b.slug)!.length - feed.rankedByCountry.get(a.slug)!.length || a.name.localeCompare(b.name));
const featured = byCount.filter((d) => placePhoto(d.slug)).slice(0, 12);
const withPhoto = (slugs: string[]) => slugs.find((s) => placePhoto(s)) ?? featured[0]?.slug ?? '';
const regionPhoto = (r: string) => withPhoto((feed.countriesByRegion.get(r) ?? []).map((d) => d.slug).sort((a, b) => feed.rankedByCountry.get(b)!.length - feed.rankedByCountry.get(a)!.length));
const hero = placePhoto(site.heroPhoto) ? site.heroPhoto : featured[0]?.slug;
const heroImg = hero ? await getImage({ src: placePhoto(hero)!.src, widths: [640, 960, 1280, 1600], format: 'webp', quality: 70 }) : null;
const nicheCounts = niches.map((n) => ({ n, count: [...feed.niche.get(n.slug)!.values()].reduce((s, l) => s + l.length, 0) })).filter((x) => x.count > 0);
---
<Base title={site.name} description={site.positioning} path="/" ogType="website" full preloadSrcset={heroImg?.srcSet.attribute} preloadSizes="100vw">
  <section class="hero" aria-labelledby="hero-h">
    {hero && <Photo slug={hero} alt="" priority sizes="100vw" widths={[640, 960, 1280, 1600]} />}
    <div class="wrap hero-body">
      <p class="hero-kicker">Published by {site.publisher.name}</p>
      <h1 id="hero-h" class="display">Find a local operator you can trust</h1>
      <div class="callout">
        <p>{site.positioning}</p>
        <a class="pill pill-dark" href={url.countries()}>Browse {feed.countries.length} countries</a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="best-h">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <h2 id="best-h">Best local operators by country</h2>
          <p>Every company listed is verified by Tourground or founder-owned, and ranked on merit. {disclosure.rankingStatement.split('. ')[1]}</p>
        </div>
        <div class="sec-tools"><a class="viewall" href={url.countries()}>View all</a><Carousel id="row-countries" label="countries" /></div>
      </div>
      <MockNotice />
      <div class="row" id="row-countries">
        {featured.map((d) => <CountryCard d={d} />)}
      </div>
    </div>
  </section>

  <section class="section section-band" aria-labelledby="start-h">
    <div class="wrap">
      <h2 id="start-h" class="band-rule"><span>Your trip starts here.</span><span class="line" aria-hidden="true"></span><span class="r">Check before you pay.</span></h2>
      <div class="tiles">
        <Tile slug={withPhoto(['georgia', 'nepal'])} kicker="Before you book" title="The booking guide" href={url.guide()} cta="Read the guide" />
        <Tile slug={withPhoto(['chile', 'iceland'])} kicker="What we check" title="Verification" href={url.verification()} cta="How it works" />
        <Tile slug={withPhoto(['zambia', 'botswana'])} kicker="Ranked on merit" title="Best lists" href={url.best()} cta="See the lists" />
        <Tile slug={withPhoto(['cambodia', 'japan'])} kicker="One page" title="The checklist" href={url.checklist()} cta="Print it" />
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="regions-h">
    <div class="wrap">
      <div class="sec-head">
        <h2 id="regions-h">Browse by region</h2>
        <div class="sec-tools"><a class="viewall" href={url.regions()}>View all</a><Carousel id="row-regions" label="regions" /></div>
      </div>
      <div class="row" id="row-regions">
        {regions.filter((r) => (feed.countriesByRegion.get(r.slug) ?? []).length > 0).map((r) => {
          const l = feed.countriesByRegion.get(r.slug)!;
          return (
            <article class="card">
              <a href={url.region(r.slug)} tabindex="-1" aria-hidden="true"><Photo slug={regionPhoto(r.slug)} alt="" credit={false} /></a>
              <p class="meta"><span>Region</span><span>{t.countriesListed(l.length)}</span></p>
              <h3><a href={url.region(r.slug)}>{r.name}</a></h3>
              <a class="pill" href={url.region(r.slug)} aria-label={`Explore ${r.name}`}>Explore</a>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section section-grey" aria-labelledby="niche-h">
    <div class="wrap">
      <div class="sec-head">
        <div><h2 id="niche-h">Ranked by niche</h2><p>Grouped by country, each in that country's rank order.</p></div>
        <a class="viewall" href={url.best()}>View all</a>
      </div>
      <div class="grid">
        {nicheCounts.map(({ n, count }) => (
          <article class="card card-text">
            <p class="meta"><span>Ranked list</span><span>{count} listed</span></p>
            <h3><a href={url.niche(n.slug)}>Best local operators for {n.name.toLowerCase()}</a></h3>
            <a class="pill" href={url.niche(n.slug)} aria-label={`See the ${n.name} list`}>See the list</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  {questions.length > 0 && (
    <section class="section" aria-labelledby="q-h">
      <div class="wrap">
        <div class="sec-head">
          <h2 id="q-h">Questions travellers ask</h2>
          <div class="sec-tools"><a class="viewall" href={url.questions()}>View all</a><Carousel id="row-q" label="questions" /></div>
        </div>
        <div class="row" id="row-q">
          {questions.map((q) => (
            <article class="card card-text">
              <p class="meta"><span>Question</span><span>Short answer</span></p>
              <h3><a href={url.question(q.id)}>{q.data.title}</a></h3>
              <p>{q.data.short_answer.split('. ')[0]}.</p>
              <a class="pill" href={url.question(q.id)} aria-label={`Read the answer: ${q.data.title}`}>Read the answer</a>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section section-grey" aria-labelledby="how-h">
    <div class="wrap">
      <div class="tiles">
        <div>
          <p class="label"><Check /> How verification works</p>
          <h2 id="how-h">Only checked companies appear here</h2>
          <p>Each company page opens with a record of what was checked, by whom and when. Verification is not a licence or a guarantee, so the guide shows you how to check the rest yourself.</p>
          <a class="pill pill-dark" href={url.verification()}>What each tier checks</a>
        </div>
        <div>
          <p class="label">How ranking works</p>
          <h2>Rank is merit, never paid</h2>
          <p>{disclosure.rankingStatement}</p>
          <a class="pill" href={url.howWeRank()}>How we rank</a>
        </div>
      </div>
    </div>
  </section>
</Base>
