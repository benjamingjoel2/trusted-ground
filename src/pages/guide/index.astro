---
import StoryListing from '../../components/StoryListing.astro';
import { allStories } from '../../lib/stories';
import { url } from '../../lib/urls';
const all = await allStories();
const list = all.filter((s) => s.kind === 'guide');
---
<StoryListing path={url.guide()} title="Travel tips" filters={false} crumbs={[{ name: 'Travel tips', path: url.guide() }]}
  dek="How to book a trip with a local operator: what a DMC is, licences, insurance, memberships, deposits, red flags and what to ask before you pay."
  stories={list} all={all} />
