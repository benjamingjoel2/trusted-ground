---
import StoryPage from '../../components/StoryPage.astro';
import { url } from '../../lib/urls';
import { published, readMinutes } from '../../lib/content';
import { allStories } from '../../lib/stories';
import { render, type CollectionEntry } from 'astro:content';
export async function getStaticPaths() {
  return (await published('guide')).map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}
const { entry } = Astro.props as { entry: CollectionEntry<'guide'> };
const { Content } = await render(entry);
const d = entry.data;
const stories = (await allStories()).filter((s) => !(s.kind === 'guide' && s.id === entry.id));
const more = [...stories.filter((s) => s.kind === 'guide'), ...stories.filter((s) => s.kind !== 'guide')].slice(0, 8);
---
<StoryPage path={url.guideChapter(entry.id)} title={d.title} description={d.description} category="Travel tips"
  published={d.published} reviewed={d.reviewed} minutes={readMinutes(entry.body)} hero={d.hero} sources={d.sources} more={more}>
  <Content />
</StoryPage>
