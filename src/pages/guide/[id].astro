---
import Base from '../../layouts/Base.astro';
import PageMeta from '../../components/PageMeta.astro';
import Sources from '../../components/Sources.astro';
import { url } from '../../lib/urls';
import { published, iso } from '../../lib/content';
import { article } from '../../lib/schema';
import { render, type CollectionEntry } from 'astro:content';
import { t } from '../../i18n/en';
export async function getStaticPaths() {
  const list = (await published('guide')).sort((a, b) => a.data.order - b.data.order);
  return list.map((entry, i) => ({ params: { id: entry.id }, props: { entry, prev: list[i - 1] ?? null, next: list[i + 1] ?? null } }));
}
type E = CollectionEntry<'guide'>;
const { entry, prev, next } = Astro.props as { entry: E; prev: E | null; next: E | null };
const { Content, headings } = await render(entry);
const d = entry.data;
const path = url.guideChapter(entry.id);
const h2s = headings.filter((h) => h.depth === 2);
---
<Base title={d.title} description={d.description} path={path}
  crumbs={[{ name: t.nav.guide, path: url.guide() }, { name: d.short_title, path }]}
  schema={[article({ path, title: d.title, description: d.description, published: iso(d.published), modified: iso(d.reviewed), sources: d.sources })]}>
  <p class="label">Guide · Part {d.order}</p>
  <h1>{d.title}</h1>
  <p class="standfirst">{d.description}</p>
  <PageMeta published={d.published} reviewed={d.reviewed} />
  {h2s.length > 2 && (
    <nav aria-label={t.onThisPage} class="small"><p class="label">{t.onThisPage}</p><ol>{h2s.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol></nav>
  )}
  <div class="prose"><Content /></div>
  <nav class="outbound" aria-label="Guide chapters">
    {prev && <a href={url.guideChapter(prev.id)}>← {prev.data.short_title}</a>}
    {next && <a href={url.guideChapter(next.id)}>{next.data.short_title} →</a>}
    <a href={url.checklist()}>Checklist</a>
  </nav>
  <Sources sources={d.sources} />
</Base>
