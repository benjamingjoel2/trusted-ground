---
import '@fontsource/archivo/latin-400.css';
import '@fontsource/archivo/latin-700.css';
import '@fontsource/archivo/latin-800.css';
import '@fontsource/anton/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/newsreader/latin-500.css';
import '../styles/global.css';
import archivo400 from '@fontsource/archivo/files/archivo-latin-400-normal.woff2?url';
import archivo700 from '@fontsource/archivo/files/archivo-latin-700-normal.woff2?url';
import anton400 from '@fontsource/anton/files/anton-latin-400-normal.woff2?url';
import serif500 from '@fontsource/newsreader/files/newsreader-latin-500-normal.woff2?url';
import { site, disclosure, regions } from '../config/site.config';
import { t } from '../i18n/en';
import { url, abs } from '../lib/urls';
import { graph, breadcrumbs as bc } from '../lib/schema';
import { getFeed } from '../lib/feed';
import { published } from '../lib/content';
import Breadcrumbs from '../components/Breadcrumbs.astro';

interface Props {
  title: string;
  description: string;
  path: string;
  crumbs?: { name: string; path: string }[];
  schema?: object[];
  noindex?: boolean;
  ogType?: 'website' | 'article';
  ogImage?: string;
  preloadImage?: string;
  preloadSrcset?: string;
  preloadSizes?: string;
  /** Full-width pages build their own structure (home, country). */
  full?: boolean;
  aside?: boolean;
}
const { title, description, path, crumbs = [], schema = [], noindex = false, ogType = 'article', ogImage, preloadImage, preloadSrcset, preloadSizes, full = false, aside = true } = Astro.props;
const canonical = abs(path);
const fullTitle = path === '/' ? `${site.name}: ${site.tagline}` : `${title} | ${site.name}`;
const allCrumbs = path === '/' ? [] : [{ name: t.breadcrumbHome, path: '/' }, ...crumbs];
const ld = graph(...(allCrumbs.length ? [bc(allCrumbs)] : []), ...schema);
const c = site.colors;
const rootVars = `:root{--white:${c.white};--grey:${c.grey};--grey-2:${c.grey2};--grey-3:${c.grey3};--line:${c.line};--ink:${c.ink};--ink-deep:${c.inkDeep};--slate:${c.slate};--lime:${c.lime};--yellow:${c.yellow};--yellow-soft:${c.yellowSoft};--blue:${c.blue};--verified:${c.verified}}`;
const nav = [
  [t.nav.countries, url.countries()],
  [t.nav.articles, url.articles()],
];
const current = (href: string) => path.startsWith(href);
const feed = getFeed();
const topCountries = [...feed.countries].sort((a, b) => feed.byCountry.get(b.slug)!.length - feed.byCountry.get(a.slug)!.length || a.name.localeCompare(b.name)).slice(0, 10);
const categories = [...new Set((await published('articles')).map((a) => a.data.category))];
---
<!doctype html>
<html lang={site.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="preload" href={anton400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={archivo400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={archivo700} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={serif500} as="font" type="font/woff2" crossorigin />
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
    {preloadSrcset && <link rel="preload" as="image" type="image/webp" imagesrcset={preloadSrcset} imagesizes={preloadSizes} fetchpriority="high" />}
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:image" content={ogImage ? abs(ogImage) : abs('/og.png')} />
    {!ogImage && <meta property="og:image:width" content="1200" />}
    {!ogImage && <meta property="og:image:height" content="630" />}
    <meta property="og:image:alt" content={`${site.name}: ${site.tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content={c.grey} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt" />
    <style set:html={rootVars}></style>
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    {site.analytics.vercel && (
      <>
        <script is:inline>window.va=window.va||function(){(window.vaq=window.vaq||[]).push(arguments)};</script>
        <script is:inline defer src="/_vercel/insights/script.js"></script>
      </>
    )}
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>
    <header class="hdr">
      <div class="hdr-inner">
        <a class="logo" href="/" aria-label={`${site.name}, home`}>
          <svg class="logo-mark" viewBox="0 0 20 20" aria-hidden="true"><rect width="20" height="20" rx="10" fill="currentColor"/><path d="M5 6.5h10M10 6.5V15" stroke="#fff" stroke-width="2.2"/></svg>
          <span class="logo-name">{site.name}</span>
        </a>
        <nav class="nav" aria-label="Main">
          <ul>
            {nav.map(([label, href]) => (
              <li><a href={href} aria-current={current(href) ? 'page' : undefined}>{label}</a></li>
            ))}
          </ul>
        </nav>
        <div class="hdr-cells">
          <a href={url.regions()}>{t.nav.regions}</a>
          <a href={url.about()}>About</a>
        </div>
      </div>
    </header>
    <main id="main">
      {full ? (
        <slot />
      ) : (
        <div class="wrap">
          <div class="page-head">{allCrumbs.length > 0 && <Breadcrumbs items={allCrumbs} />}</div>
          <div class="layout layout-single">
            <div class="main"><slot /></div>
          </div>
        </div>
      )}
    </main>
    <footer class="foot">
      <div class="wrap">
        <div class="foot-top">
          <div class="foot-brand">
            <span class="logo-name">{site.name}</span>
            <p>{disclosure.footerShort}</p>
            <p class="foot-pub"><a href={site.publisher.url}>{disclosure.footerPublishedBy}</a></p>
            <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
          </div>
          <nav aria-label="Top destinations">
            <h2>Top destinations</h2>
            <ul>
              {topCountries.map((d) => <li><a href={url.country(d.slug)}>{d.name}</a></li>)}
              <li><a href={url.countries()}>All countries</a></li>
            </ul>
          </nav>
          <nav aria-label="Stories">
            <h2>Stories</h2>
            <ul>
              {categories.map((c) => <li><a href={`${url.articles()}#${c.replace(/\W+/g, '-').toLowerCase()}`}>{c}</a></li>)}
              <li><a href={url.articles()}>All stories</a></li>
            </ul>
          </nav>
          <nav aria-label="About">
            <h2>About</h2>
            <ul>
              <li><a href={url.about()}>About</a></li>
              <li><a href={url.disclosure()}>Publisher disclosure</a></li>
              <li><a href={url.corrections()}>Corrections and removal</a></li>
              <li><a href="/credits/">Photo credits</a></li>
              <li><a href={url.privacy()}>Privacy Policy</a></li>
              <li><a href={url.terms()}>Terms</a></li>
              <li><a href={url.cookies()}>Cookie Policy</a></li>
            </ul>
          </nav>
        </div>
        <div class="foot-bottom">
          <span>{site.name} · {site.domain}</span>
          <span>{regions.map((r, i) => (<>{i > 0 && ' · '}<a href={url.region(r.slug)}>{r.name}</a></>))}</span>
        </div>
      </div>
    </footer>
  </body>
</html>
