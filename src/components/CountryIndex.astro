---
import { getFeed } from '../lib/feed';
import { regions } from '../config/site.config';
import { url } from '../lib/urls';
import { t } from '../i18n/en';
const { current = '' } = Astro.props as { current?: string };
const feed = getFeed();
---
<details class="cindex" open>
  <summary class="label">{t.marginIndex}</summary>
  {regions.map((r) => {
    const list = feed.countriesByRegion.get(r.slug) ?? [];
    return list.length > 0 && (
      <div class="cindex-group">
        <p class="cindex-region"><a href={url.region(r.slug)}>{r.name}</a></p>
        <ul>
          {list.map((d) => (
            <li><a href={url.country(d.slug)} aria-current={current === url.country(d.slug) ? 'page' : undefined}>{d.name}</a></li>
          ))}
        </ul>
      </div>
    );
  })}
  <p class="cindex-all"><a href={url.countries()}>{t.marginIndexAll} →</a></p>
</details>
