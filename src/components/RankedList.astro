---
import type { RankedEntry } from '../lib/feed';
import { destName } from '../lib/feed';
import { niches } from '../config/site.config';
import { url } from '../lib/urls';
import { fmtDate } from '../lib/content';
import { t } from '../i18n/en';
import TierBadge from './TierBadge.astro';
interface Props { entries: RankedEntry[]; caption: string; showBase?: boolean }
const { entries, caption, showBase = true } = Astro.props;
const nicheName = (s: string) => niches.find((n) => n.slug === s)?.name ?? s;
---
<table class="register">
  <caption class="vh">{caption}</caption>
  <thead>
    <tr>
      <th scope="col" class="num">{t.rank}</th>
      <th scope="col">{t.operator}</th>
      <th scope="col">{t.kind}</th>
      {showBase && <th scope="col">{t.basedIn}</th>}
      <th scope="col">{t.specialties}</th>
      <th scope="col">{t.lastChecked}</th>
    </tr>
  </thead>
  <tbody>
    {entries.map((e) => (
      <tr>
        <td class="num" data-label={t.rank}>{String(e.rank).padStart(2, '0')}</td>
        <th scope="row" data-label={t.operator}>
          <a href={url.operator(e.company.id)} class="entry-name">{e.company.name}</a>
          <TierBadge company={e.company} />
        </th>
        <td data-label={t.kind}>{t.kindShort[e.company.kind]}</td>
        {showBase && <td data-label={t.basedIn}>{e.company.base_city ? `${e.company.base_city}, ` : ''}{destName(e.company.country_base)}</td>}
        <td data-label={t.specialties}>{e.company.niches.length ? e.company.niches.map(nicheName).join(', ') : '–'}</td>
        <td data-label={t.lastChecked} class="tnum"><time datetime={e.company.last_checked}>{fmtDate(e.company.last_checked)}</time></td>
      </tr>
    ))}
  </tbody>
</table>
