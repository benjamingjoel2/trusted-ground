---
/** The checkmark motif. Use ONLY for verification states. */
interface Props { label?: string }
const { label } = Astro.props;
---
<svg class="check" viewBox="0 0 16 16" width="14" height="14" aria-hidden={label ? undefined : 'true'} role={label ? 'img' : undefined} aria-label={label}><path d="M3 8.5l3.2 3L13 4.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"/></svg>
