---
/**
 * Paid placement slot. Not built yet: always renders empty.
 * When paid placement launches, it renders ONLY here: at the top, labelled,
 * visually separate, and it never changes the ranked list.
 */
import { disclosure, site } from '../config/site.config';
interface Props { feature?: { title: string; body: string; href: string } | null; specimen?: boolean }
const { feature = null, specimen = false } = Astro.props;
const show = !!feature || specimen || site.showEmptyAdSlot;
---
{show && (
<aside class="adslot" aria-label={disclosure.paidLabel}>
  <p class="adslot-label">{disclosure.paidLabel}</p>
  {feature ? (
    <div class="adslot-body">
      <p class="adslot-title"><a href={feature.href} rel="sponsored nofollow noopener">{feature.title}</a></p>
      <p>{feature.body}</p>
    </div>
  ) : (
    <p class="adslot-empty">{disclosure.paidSlotEmpty}</p>
  )}
  <p class="adslot-note">{disclosure.paidSlotNote}</p>
</aside>
)}
