---
import { tiers, site } from '../config/site.config';
import type { Company } from '../lib/feed';
import Check from './Check.astro';
interface Props { company: Company }
const { company: c } = Astro.props;
const tier = tiers[c.tier];
---
<span class="tierline">
  {c.verified && <span class="vstate"><Check />Verified</span>}
  <span class={`tier tier-${c.tier}`}>{tier.label}{tier.paid && ' (paid plan)'}</span>
  {c.founder_owned && <span class="founder">{site.publisher.founderLabel}</span>}
  {c.example && <span class="example">Example</span>}
</span>
