---
import StoryCard from './StoryCard.astro';
import { url } from '../lib/urls';
import { readMinutes } from '../lib/content';
import { getFeed } from '../lib/feed';
import type { CollectionEntry } from 'astro:content';
interface Props { a: CollectionEntry<'articles'>; size?: 'lg' | 'md' }
const { a, size } = Astro.props;
const feed = getFeed();
const s = {
  kind: 'article' as const, id: a.id, href: url.article(a.id), title: a.data.title, description: a.data.description,
  category: a.data.category, hero: a.data.hero ?? a.data.countries[0], countries: a.data.countries,
  regions: [...new Set(a.data.countries.map((c) => feed.destBySlug.get(c)?.region).filter(Boolean) as string[])],
  published: a.data.published, minutes: readMinutes(a.body),
};
---
<StoryCard s={s} size={size} />
